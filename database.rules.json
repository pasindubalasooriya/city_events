{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "events": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || data.child('ownerUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['title','dateTime','ownerUid','lat','lng']) && (!data.exists() || newData.child('ownerUid').val() === data.child('ownerUid').val())",
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "category": { ".validate": "newData.isString() && newData.val().matches(/^(Music|Sports|Tech|Food|Community|Other)$/)" },
        "imageUrl": { ".validate": "newData.isString() && newData.val().beginsWith('https://')" },
        "venueName": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "dateTime": { ".validate": "newData.isNumber()" },
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "isOutdoor": { ".validate": "newData.isBoolean()" },
        "ownerUid": { ".validate": "newData.isString()" },
        "ownerName": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "attendees": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
